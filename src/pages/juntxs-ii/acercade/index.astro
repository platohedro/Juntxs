---
import JuntxsIILayout from '../../../layouts/JuntxsIILayout.astro';
---

<JuntxsIILayout title="Juntxs II: Acerca de">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <h1 class="text-3xl sm:text-4xl font-bold text-white mb-4 sm:mb-8 text-center">Juntxs II</h1>

    <p class="bg-j2-primary/80 rounded-xl m-4 p-2 text-lg text-white mb-6 sm:mb-8 max-w-3xl mx-auto">
      Esta nueva fase de Juntxs amplía la colaboración entre Platohedro y El Eje, integrando procesos con territorios aliados y consolidando una paleta visual propia para diferenciar el proyecto paralelo sin perder coherencia.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 sm:gap-6 md:gap-8">
      <div class="col-span-1 sm:col-span-2 md:col-span-3 flex justify-center">
        <img src="/imagenes/FOTO1.jpg" alt="Juntxs II" class="w-full h-full object-cover rounded-xl" />
      </div>
    </div>
  </main>
</JuntxsIILayout>
