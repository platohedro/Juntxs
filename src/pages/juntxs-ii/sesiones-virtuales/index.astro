---
import JuntxsIILayout from '../../../layouts/JuntxsIILayout.astro';
---

<JuntxsIILayout title="Juntxs II: Sesiones Virtuales">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-4xl font-bold text-white mb-8 text-center">Sesiones Virtuales</h1>

    <div>
      <p class="bg-j2-primary/80 rounded-xl p-2 text-lg text-white m-8">
        La estrategia virtual de Juntxs II se enfoca en la apropiación de herramientas para la sostenibilidad cultural. Tres sesiones abiertas al público articulan expertas invitadas y materiales descargables.
      </p>
    </div>
    <div class="bg-white rounded-lg shadow-md p-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        <div class="bg-gray-100 p-4 rounded-lg">
          <div class="aspect-w-16 aspect-h-9 mb-4">
            <div class="bg-gray-200 rounded-lg flex items-center justify-center">
              <span class="text-gray-800">Sesión 1</span>
            </div>
          </div>

          <iframe
            src="https://www.youtube.com/embed/dvcg63JqXWU?si=Jkja_8ptPI2L6yL-"
            width="100%"
            height="315"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            class="rounded-lg"
          >
          </iframe>
          <p class="text-lg text-gray-600 text-center pt-8">
           19 Noviembre 2025
          </p>
        </div>

        <div class="bg-gray-100 p-4 rounded-lg">
          <div class="aspect-w-16 aspect-h-9 mb-4">
            <div class="bg-gray-200 rounded-lg flex items-center justify-center">
              <span class="text-gray-800">Sesión 2</span>
            </div>
          </div>

          <iframe
            src="https://www.youtube.com/embed/IFwJBC7F67Y?si=aaqx7Ke50Oz9KRm2"
            width="100%"
            height="315"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            class="rounded-lg"
          >
          </iframe>
          <p class="text-lg text-gray-600 text-center pt-8">
            26 Noviembre 2025
          </p>
        </div>

        <div class="bg-gray-100 p-4 rounded-lg">
          <div class="aspect-w-16 aspect-h-9 mb-4">
            <div class="bg-gray-200 rounded-lg flex items-center justify-center">
              <span class="text-gray-800">Sesión 3</span>
            </div>
          </div>

          <iframe
            src="https://www.youtube.com/embed/jO2C-3WzNVM?si=BDEY6hagATW_L3FG"
            width="100%"
            height="315"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            class="rounded-lg"
          >
          </iframe>
          <p class="text-lg text-gray-600 text-center pt-8">
           3 diciembre 2025
          </p>
        </div>
      </div>
    </div>
  </main>
</JuntxsIILayout>
