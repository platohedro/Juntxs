---
import JuntxsIILayout from '../../../layouts/JuntxsIILayout.astro';
---

<JuntxsIILayout title="Juntxs II: Relatorías">
  <section class="bg-j2-primary/20">
    <div class="container mx-auto p-4 md:p-6 lg:p-8">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white text-center mb-4 md:mb-6 lg:mb-8">Relatorías</h2>
      <p class="text-center mb-4 md:mb-6 lg:mb-8 text-lg md:text-xl lg:text-2xl text-white bg-j2-primary/80 rounded-lg p-2">Aquí encontrarás las relatorías de los encuentros de Juntxs II.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 lg:gap-8">
        <a href="/juntxs-ii/relatorias/1" class="bg-j2-secondary/80 rounded-lg shadow-lg p-4 md:p-6 lg:p-8 border border-j2-light/30">
          <h3 class="text-white text-lg md:text-xl lg:text-2xl font-bold">Relatoría 1</h3>
          <p class="text-sm md:text-base lg:text-lg text-white">Encuentro 1</p>
        </a>
        <a href="/juntxs-ii/relatorias/2" class="bg-j2-secondary/80 rounded-lg shadow-lg p-4 md:p-6 lg:p-8 border border-j2-light/30">
          <h3 class="text-white text-lg md:text-xl lg:text-2xl font-bold">Relatoría 2</h3>
          <p class="text-sm md:text-base lg:text-lg text-white">Encuentro 2</p>
        </a>
        <a href="/juntxs-ii/relatorias/3" class="bg-j2-secondary/80 rounded-lg shadow-lg p-4 md:p-6 lg:p-8 border border-j2-light/30">
          <h3 class="text-white text-lg md:text-xl lg:text-2xl font-bold">Relatoría 3</h3>
          <p class="text-sm md:text-base lg:text-lg text-white">Encuentro 3</p>
        </a>
      </div>
    </div>
  </section>
</JuntxsIILayout>
