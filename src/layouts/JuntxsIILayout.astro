---
interface Props {
  title: string;
  backgroundImageUrl?: string;
}

const navLinks = [
  { label: 'Asamblea', href: '/juntxs-ii/asamblea' },
  { label: 'Caravana', href: '/juntxs-ii/caravana' },
  
  { label: 'Cuando El rio Suena', href: '/juntxs-ii/cuandoelriosuena' },
  { label: 'Sesiones Virtuales', href: '/juntxs-ii/sesiones-virtuales' },
  { label: 'Acerca de', href: '/juntxs-ii/acercade' }
];

const defaultBackgroundImage = '/imagenes/BG-2.png';
const { title, backgroundImageUrl = defaultBackgroundImage } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/phb.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <style>
      @media (min-width: 768px) {
        #desktop-menu {
          display: flex !important;
        }
        #mobile-menu-button {
          display: none !important;
        }
      }
      
      @media (max-width: 767px) {
        #desktop-menu {
          display: none !important;
        }
        #mobile-menu-button {
          display: block !important;
        }
      }
      
      #mobile-menu {
        display: none;
        background-color: rgba(12, 4, 45, 0.9);
        backdrop-filter: blur(4px);
      }
      
      #mobile-menu.show {
        display: block;
      }
      
      .mobile-link {
        display: block;
        padding: 0.75rem 1rem;
        color: white;
        border-radius: 0.375rem;
      }
      
      .mobile-link:hover {
        background-color: rgba(255, 94, 219, 0.2);
      }

      html, body {
        margin: 0;
        padding: 0;
        overflow-x: hidden;
      }

      body {
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        min-height: 100vh;
      }

      #site-footer {
        display: none;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 40;
      }

      #site-footer.visible {
        display: block;
      }
    </style>
  </head>
  <body style={`background-image: url('${backgroundImageUrl}');`}>
    <nav class="bg-j2-secondary/80 backdrop-blur-sm fixed w-full z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex items-center space-x-4">
            <a href="/juntxs-ii" class="flex items-center">
              <span class="text-xl font-bold text-white">Juntxs II</span>
            </a>
            <a href="/" class="text-sm text-j2-light hover:text-j2-accent transition-colors">Volver a Juntxs I</a>
          </div>
          
          <div id="desktop-menu" class="items-center space-x-4">
            {navLinks.map(link => (
              <a href={link.href} class="text-white hover:text-j2-highlight transition-colors">{link.label}</a>
            ))}
          </div>
          
          <button id="mobile-menu-button" type="button" class="text-white">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>
      
      <div id="mobile-menu">
        <div class="px-2 pt-2 pb-3 space-y-1">
          {navLinks.map(link => (
            <a href={link.href} class="mobile-link">{link.label}</a>
          ))}
          <a href="/" class="mobile-link text-j2-highlight">Volver a Juntxs I</a>
        </div>
      </div>
    </nav>
    
    <div class="pt-16 pb-24">
      <slot />
    </div>

    <footer id="site-footer" class="bg-j2-secondary/80 backdrop-blur-sm text-white py-4 w-full">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="flex flex-col items-center justify-center gap-2">
          <img src="/imagenes/CULTURAS_BLANCO.png" alt="Ministerio de Cultura" class="h-10" />
          <p class="text-sm text-j2-light">Proyecto Juntxs II · Encuentros vivos, cultura en movimiento</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      window.addEventListener('load', function() {
        const menuButton = document.getElementById('mobile-menu-button');
        const mobileMenu = document.getElementById('mobile-menu');
        
        if (menuButton && mobileMenu) {
          menuButton.addEventListener('click', function() {
            mobileMenu.classList.toggle('show');
          });
        }

        const footer = document.getElementById('site-footer');
        window.addEventListener('scroll', function() {
          if ((window.innerHeight + window.scrollY) >= document.body.offsetHeight - 200) {
            footer.classList.add('visible');
          } else {
            footer.classList.remove('visible');
          }
        });
      });
    </script>
  </body>
</html>
