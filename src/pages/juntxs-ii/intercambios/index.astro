---
import JuntxsIILayout from '../../../layouts/JuntxsIILayout.astro';

const ciudades = [
  {
    id: 'medellin',
    nombre: 'El Eje en Medellín',
    descripcion: 'Encuentros con laboratorios de creación colaborativa junto al ecosistema de Platohedro.',
    imagen: '/imagenes/FACHADA1.jpg'
  },
  {
    id: 'bogota',
    nombre: 'Platohedro en Bogotá',
    descripcion: 'Transferencia de metodologías con las comunidades rurales que acompañan a El Eje.',
    imagen: '/imagenes/eleje.jpg'
  }
];
---

<JuntxsIILayout title="Juntxs II: Intercambios">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-4xl font-bold text-white mb-8 text-center">Intercambios Culturales</h1>

    <p class="bg-j2-primary/80 rounded-xl p-2 text-lg text-white m-8">
      Para Juntxs II continuamos con los laboratorios de intercambio entre Medellín y Bogotá rural, ampliando la red hacia territorios aliados. Cada encuentro es una oportunidad de aprendizaje mutuo y formulación colectiva de proyectos.
    </p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {ciudades.map(ciudad => (
        <a href={`/juntxs-ii/intercambios/${ciudad.id}`} class="block group">
          <div class="bg-white rounded-lg shadow-md overflow-hidden transition transform hover:scale-105">
            <img src={ciudad.imagen} alt={ciudad.nombre} class="w-full h-64 object-cover" />
            <div class="p-6">
              <h2 class="text-2xl font-semibold text-gray-900 mb-2">{ciudad.nombre}</h2>
              <p class="text-lg text-gray-600">{ciudad.descripcion}</p>
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>
</JuntxsIILayout>
