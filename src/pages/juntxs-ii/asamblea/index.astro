  {
    id: 'maria',
    nombre: 'María C',
    descripcion: 'Explora la relación entre tecnologías y cuidado del agua desde prácticas transdisciplinarias.',
    imagen: '/imagenes/mariac.jpg'
  },
  {
    id: 'laura',
    nombre: 'Laura Sofia',
    descripcion: 'Arquitecta y gestora cultural que aborda procesos de espacio público y pedagogía comunitaria.',
    imagen: '/imagenes/luara2.png'
  },
  {
    id: 'sandra',
    nombre: 'Sandra Ramirez',
    descripcion: 'Narradora visual y fotógrafa que trabaja memorias rurales y justicia ambiental.',
    imagen: '/imagenes/sandra.jpeg'
  }
];

const slidesAsamblea = [
  { src: '/imagenes/j2/slider-asamblea/1.png', alt: 'Asamblea del Agua 1' },
  { src: '/imagenes/j2/slider-asamblea/2.jpg', alt: 'Asamblea del Agua 2' },
  { src: '/imagenes/j2/slider-asamblea/3.png', alt: 'Asamblea del Agua 3' },
  { src: '/imagenes/j2/slider-asamblea/4.jpg', alt: 'Asamblea del Agua 4' },
  { src: '/imagenes/j2/slider-asamblea/5.png', alt: 'Asamblea del Agua 5' },
  { src: '/imagenes/j2/slider-asamblea/6.jpg', alt: 'Asamblea del Agua 6' },
  { src: '/imagenes/j2/slider-asamblea/7.jpg', alt: 'Asamblea del Agua 7' }
