---
import JuntxsIILayout from '../../../layouts/JuntxsIILayout.astro';

const artistas = [
  {
    id: 'maria',
    nombre: 'María C',
    descripcion: 'Explora la relación entre tecnologías y cuidado del agua desde prácticas transdisciplinarias.',
    imagen: '/imagenes/mariac.jpg'
  },
  {
    id: 'laura',
    nombre: 'Laura Sofia',
    descripcion: 'Arquitecta y gestora cultural que aborda procesos de espacio público y pedagogía comunitaria.',
    imagen: '/imagenes/luara2.png'
  },
  {
    id: 'sandra',
    nombre: 'Sandra Ramirez',
    descripcion: 'Narradora visual y fotógrafa que trabaja memorias rurales y justicia ambiental.',
    imagen: '/imagenes/sandra.jpeg'
  }
];
---

<JuntxsIILayout title="Juntxs II: Circulación">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <h1 class="text-3xl sm:text-4xl font-bold text-white mb-4 sm:mb-8 text-center">Circulación</h1>

    <p class="bg-j2-primary/80 rounded-xl m-4 p-2 text-lg text-white mb-6 sm:mb-8">
      El componente de circulación de Juntxs II continúa expandiendo la red de afectos mediante la participación en festivales, residencias y laboratorios donde artistas comparten metodologías de creación colectiva.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 sm:gap-6 md:gap-8">
      {artistas.map(artista => (
        <a href={`/juntxs-ii/circulacion/${artista.id}`} class="block group">
          <div class="bg-white rounded-lg shadow-md overflow-hidden transition transform hover:scale-105">
            <img src={artista.imagen} alt={artista.nombre} class="w-full h-40 sm:h-48 object-cover" />
            <div class="p-4 sm:p-6">
              <h2 class="text-xl sm:text-2xl font-semibold text-gray-900 mb-2">{artista.nombre}</h2>
              <p class="text-lg text-gray-600">{artista.descripcion}</p>
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>
</JuntxsIILayout>
